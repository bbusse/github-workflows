FROM alpine:3.24.1

# alpine-sdk creates the "abuild" system group as part of its install;
# abuild refuses to run as root, so the actual package build step drops
# to this user via `sudo -u builder`. The container itself stays root by
# default so GitHub Actions' own steps (checkout, download/upload-artifact)
# can write to the runner-owned workspace mount.
RUN apk add --no-cache alpine-sdk sudo openssl \
    && adduser -D builder \
    && addgroup builder abuild \
    && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder \
    && mkdir -p /home/builder/.abuild /home/builder/packages \
    && chown -R builder:abuild /home/builder
