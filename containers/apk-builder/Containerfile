FROM alpine:3.24.1

# alpine-sdk creates the "abuild" system group as part of its install;
# abuild refuses to run as root, so packaging happens as this user instead.
RUN apk add --no-cache alpine-sdk sudo openssl \
    && adduser -D builder \
    && addgroup builder abuild \
    && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder \
    && mkdir -p /home/builder/.abuild /home/builder/packages \
    && chown -R builder:abuild /home/builder

USER builder
WORKDIR /home/builder
